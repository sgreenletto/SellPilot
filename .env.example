# Safe local-development placeholders only. Copy to .env and replace locally.
APP_NAME=SellPilot
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://sellpilot:replace_me@localhost:5432/sellpilot
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LLM_PROVIDER=replace_me
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me
PLATFORM_ADAPTER=mock

# Frontend public development configuration (never place secrets in VITE_* variables).
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Real mode remains a non-networking stub. These values must stay unset in mock mode.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_SHOP_ID=
