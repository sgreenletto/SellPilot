  "keywords": [
    "sellpilot",
    "vue",
    "dashboard"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vue-tsc": "^3.3.8"
